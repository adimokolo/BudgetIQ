{
  "expo": {
    "name": "KashMetrix",
    "slug": "BudgetIQ-Mobile-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "budgetiq",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.getbudgetiq.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0756C9",
        "foregroundImage": "./assets/images/foreground-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.getbudgetiq.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8683588639077779~3693928842",
          "iosAppId": "ca-app-pub-8683588639077779~8124128442"
        }
      ],
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c5e07ed8-e6ca-4f08-9039-b3ec7d63b4ec"
      }
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-8683588639077779~3693928842",
    "ios_app_id": "ca-app-pub-8683588639077779~8124128442",
    "android_sdk": "classic"
  }
}
