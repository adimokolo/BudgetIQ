# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# PostgreSQL (Amazon RDS)
# Example RDS endpoint: budgetiq-db.xxxxxxxxxx.eu-central-1.rds.amazonaws.com
PGHOST=your-rds-endpoint.rds.amazonaws.com
PGPORT=5432
PGDATABASE=budgetiq
PGUSER=budgetiq_admin
PGPASSWORD=replace_with_secure_password
PGSSL=true

# Frontend origin allowed for CORS
CLIENT_ORIGIN=http://localhost:5173
